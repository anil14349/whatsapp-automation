{
  "name": "clinic-app",
  "version": "0.1.0",
  "private": true,
  "description": "ABC Clinic WhatsApp bot + receptionist/admin UI, rewritten on Next.js + Supabase (Postgres). Ports the functionality of the Apps Script bot in ../src.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:types": "supabase gen types typescript --local > lib/supabase/database.types.ts",
    "create-admin": "node scripts/create-admin-user.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "googleapis": "^144.0.0",
    "next": "15.5.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.25",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}

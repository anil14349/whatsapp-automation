{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/auto-complete",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/log-cleanup",
      "schedule": "0 3 * * *"
    }
  ]
}

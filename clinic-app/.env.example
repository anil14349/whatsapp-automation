# Copy this file to .env.local and fill in real values.
# Never commit .env.local (it's already gitignored).

# ------------------------------------------------------------------
# Supabase
# ------------------------------------------------------------------
# From `supabase start` output for local dev, or your cloud project's
# Settings -> API page once you've created one.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side only, NEVER expose to the browser.
# Used by API routes / the WhatsApp webhook to bypass Row Level Security
# for trusted server-side operations.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# WhatsApp Cloud API (Meta) — same credentials as the Apps Script bot
# ------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Webhook GET verification token you choose (must match Meta app config)
WHATSAPP_VERIFY_TOKEN=
# Extra POST lock: Meta's callback URL must include ?token=THIS_VALUE
WHATSAPP_WEBHOOK_POST_TOKEN=

# ------------------------------------------------------------------
# Google Calendar (kept, per-doctor calendars) — service account with
# each doctor's calendar shared to its email address (Calendar
# Settings -> Share with specific people -> "Make changes to events").
# ------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key field from the service account JSON, keeping the
# \n sequences literal (not real newlines) — the code un-escapes them.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ------------------------------------------------------------------
# WhatsApp Flows (native in-chat "Book Appointment" form) — optional.
# Leave blank to keep using the existing list/button booking flow; the
# ENABLE_WHATSAPP_FLOW_BOOKING setting in /admin/settings has nothing to
# turn on until these are set. See clinic-app/README.md's WhatsApp Flows
# section and scripts/generate-flow-keypair.mjs.
# ------------------------------------------------------------------
WHATSAPP_FLOW_ID=
# Same \n-literal convention as GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY above.
WHATSAPP_FLOW_PRIVATE_KEY=
WHATSAPP_FLOW_PRIVATE_KEY_PASSPHRASE=

# ------------------------------------------------------------------
# Admin UI auth (receptionist/admin login)
# ------------------------------------------------------------------
# Used to sign session cookies for the admin app. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# ------------------------------------------------------------------
# Misc
# ------------------------------------------------------------------
# IANA timezone used for all date/time formatting (matches TIMEZONE in
# the Apps Script Config.gs)
CLINIC_TIMEZONE=Asia/Kolkata

# Copy this file to .env.local and fill in real values.
# Do not commit .env.local.

# Supabase Configuration
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# automatically into deployed Edge Functions and by `supabase functions serve`.
# Do NOT set them via `supabase secrets set` - the SUPABASE_ prefix is reserved.

# JWT Configuration
# Generate your own random secret. PowerShell example:
# [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Email Service (Optional - for password resets)
# From Resend dashboard, if you enable email sending.
RESEND_API_KEY=your-resend-api-key-here

# WhatsApp Configuration
# From Meta WhatsApp Cloud API / App dashboard
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token
# Checked on GET webhook verification (hub.verify_token)
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
# Checked on POST as the ?token= query parameter
WHATSAPP_WEBHOOK_POST_TOKEN=your-webhook-post-token

# Database
# From Supabase Dashboard -> Project Settings -> Database
DATABASE_URL=postgresql://user:password@host:5432/postgres

# App Configuration
ENVIRONMENT=development
API_BASE_URL=http://localhost:54321

# Comma-separated origins allowed to call the portal API from a browser.
# Leave unset to allow any origin (development only).
ALLOWED_ORIGINS=http://localhost:3000

# Doctors authenticate with their own bcrypt PIN (doctors.pin_hash), issued by
# an admin via the staff endpoint. Set this to "true" only to temporarily allow
# the shared DOCTOR_PORTAL_PIN for doctors who have no PIN of their own - it
# opens every such account to anyone holding that one PIN.
# ALLOW_SHARED_DOCTOR_PIN=true